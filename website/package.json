{
  "name": "word-diffusion-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run copy-models && npm run build-website",
    "build-website": "vite build",
    "build-onnx": "./scripts/build-custom-onnx.sh",
    "build-full": "npm run build-onnx && npm run build",
    "preview": "vite preview",
    "copy-models": "node scripts/copy-model-files.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "onnxruntime-web": "1.24.2"
  }
}